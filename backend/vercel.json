{
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/ads/cron/cleanup",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/v1/account/cron/daily",
      "schedule": "0 1 * * *"
    }
  ]
}
