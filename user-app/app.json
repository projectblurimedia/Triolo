{
  "expo": {
    "name": "Triolo",
    "slug": "triolo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projectblurimedia.triolo"
    },
    "android": {
      "package": "com.projectblurimedia.triolo",
      "adaptiveIcon": {
        "backgroundColor": "#001B57",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#001B57",
          "dark": {
            "backgroundColor": "#001B57"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Triolo uses your location to find services and shops near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Triolo needs access to your photos to upload portfolio or shop images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dcec88c3-6d98-4b27-a064-f9ea883a4cdd"
      }
    },
    "owner": "projectblurimedia",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dcec88c3-6d98-4b27-a064-f9ea883a4cdd",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    }
  }
}
