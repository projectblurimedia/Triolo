{
  "expo": {
    "name": "NearbyU Partner",
    "slug": "triolo-partner",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projectblurimedia.triolopartner"
    },
    "android": {
      "package": "com.projectblurimedia.triolopartner",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A3FB8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A3FB8",
          "dark": {
            "backgroundColor": "#0A3FB8"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Triolo Partner uses your location to set your service or shop location and to share your live location with a customer while you travel to a job.",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Triolo Partner needs access to your photos to upload portfolio or shop images.",
          "cameraPermission": "Triolo Partner uses your camera to take a photo of the bill or items."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0055D3",
          "sounds": [
            "./assets/sounds/nearbyu_notification.wav"
          ],
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-task-manager",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "./plugins/withLivePopup",
      "./plugins/withUpiApps",
      "./plugins/withKeepNotificationSound",
      [
        "expo-audio",
        {
          "microphonePermission": "Triolo Partner uses your microphone to record a voice message with your bill."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keepclassmembers class * { @android.webkit.JavascriptInterface <methods>; }\n-keepattributes JavascriptInterface\n-keepattributes *Annotation*\n-dontwarn com.razorpay.**\n-keep class com.razorpay.** {*;}\n-optimizations !method/inlining/*\n-keepclasseswithmembers class * { public void onPayment*(...); }\n-keep class expo.modules.adapters.react.apploader.** { *; }\n-keep class expo.modules.apploader.** { *; }\n-keep class expo.modules.taskManager.** { *; }\n-keep class * implements expo.modules.interfaces.taskManager.TaskConsumerInterface { *; }\n-keep class expo.modules.notifications.** { *; }\n-keep class expo.modules.location.** { *; }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "694506a1-a8f3-44aa-9a0a-9a672f110fd0"
      }
    },
    "owner": "projectblurimedia",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/694506a1-a8f3-44aa-9a0a-9a672f110fd0",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "scheme": "triolopartner"
  }
}
